# Database
DATABASE_ENABLED=false
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/legal_metrology_db

# Application
APP_NAME=Legal Metrology Compliance Checker
APP_VERSION=1.1.3-prod
DEBUG=false
PORT=8000

# CORS & Networking
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=

# File paths
UPLOAD_DIR=uploads
REPORT_DIR=generated_reports

# OCR & Classification
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.5
CATEGORY_CONFIDENCE_THRESHOLD=0.6

# Performance & Memory Optimization
MAX_OCR_IMAGE_DIMENSION=1536
MAX_IMAGES_PER_INSPECTION=8
OCR_CONCURRENCY=1
PADDLE_CPU_THREADS=1

# Upload Limits
MAX_UPLOAD_SIZE_MB=15

# Security
SECRET_KEY=change-this-to-a-random-secret-key

